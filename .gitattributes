# Default to LF in the repo, let git convert on Windows checkout when needed.
* text=auto eol=lf

# Go, proto and config sources are always LF.
*.go    text eol=lf
*.proto text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.sql   text eol=lf

# Generated files: keep diffs collapsed in review tools.
*.pb.go              linguist-generated=true
*_grpc.pb.go         linguist-generated=true
*.pb.gw.go           linguist-generated=true
wire_gen.go          linguist-generated=true
gen/**               linguist-generated=true
gen/openapi/*.yaml   linguist-generated=true
internal/conf/*.pb.go linguist-generated=true

# Binaries.
*.png binary
*.jpg binary
*.ico binary
