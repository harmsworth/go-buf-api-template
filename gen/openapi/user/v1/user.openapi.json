{
  "openapi": "3.1.0",
  "info": {
    "title": "user",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/auth/login": {
      "post": {
        "tags": [
          "UserService"
        ],
        "summary": "登录并签发令牌。非幂等（令牌 rotation）。",
        "operationId": "UserService_Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "description": "明文密码仅存在于 TLS 通道内；长度遵循 OWASP 建议 [8, 72]（bcrypt 截断上限 72 字节）。"
                  },
                  "username": {
                    "type": "string",
                    "description": "登录名（扩展：如需邮箱登录，另建 LoginByEmailRequest，勿复用消息）。"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "A successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users/{user_id}:changePassword": {
      "post": {
        "tags": [
          "UserService"
        ],
        "summary": "修改密码（本人操作，需验证旧密码）。非幂等。\n成功后服务端应吊销该用户其他会话的刷新令牌。",
        "operationId": "UserService_ChangePassword",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "description": "目标用户（必须与认证令牌的主体一致，由授权层强制）。",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newPassword": {
                    "type": "string",
                    "description": "新密码：不得与旧密码相同（服务端校验）；复杂度见上方 CEL 规则。"
                  },
                  "oldPassword": {
                    "type": "string",
                    "description": "旧密码：身份二次确认。校验失败 → FailedPrecondition；尝试次数由服务端限流。"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "A successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.ChangePasswordResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users/{user_id}:resetPassword": {
      "post": {
        "tags": [
          "UserService"
        ],
        "summary": "重置密码（管理员操作）：服务端生成一次性临时密码下发，用户首次登录强制改密。非幂等。",
        "operationId": "UserService_ResetPassword",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "description": "目标用户（管理员操作，无需旧密码）。",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "A successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.ResetPasswordResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users": {
      "get": {
        "tags": [
          "UserService"
        ],
        "summary": "分页列出用户。幂等。",
        "operationId": "UserService_ListUsers",
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "description": "分页大小：三态。未设置（Absent）= 服务端取默认值（如 20）；显式传值 = 精确控制，[1, 100]。",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageToken",
            "in": "query",
            "description": "分页游标：首页传空串；取上一次响应的 next_page_token。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "状态过滤。optional：未设置 = 不过滤（Absent），显式传值 = 精确过滤。",
            "schema": {
              "$ref": "#/components/schemas/user.v1.UserStatus"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "关键字：对 username / nickname 做模糊匹配。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "showDeleted",
            "in": "query",
            "description": "是否包含已删除用户（软删除，User.deleted_at 非空）。\n默认（未设置/false）= 排除已删除；置 true = 包含，仅管理员/审计场景使用。",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "A successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.ListUsersResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "UserService"
        ],
        "summary": "创建用户（管理员操作）。幂等性由 username 唯一约束保证（重复 → AlreadyExists）。",
        "operationId": "UserService_CreateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "邮箱，唯一性由服务端保证。"
                  },
                  "nickname": {
                    "type": "string",
                    "description": "昵称可缺省（optional 三态字段：未设置 ≠ 空串）。"
                  },
                  "password": {
                    "type": "string",
                    "description": "初始密码。复杂度见上方 message 级 CEL 规则。"
                  },
                  "phone": {
                    "type": "string",
                    "description": "手机号，创建时可缺省（与 User.phone 校验规则一致），后续可用 UpdateUser 修改。"
                  },
                  "role": {
                    "$ref": "#/components/schemas/user.v1.UserRole",
                    "description": "初始角色，创建时必须显式指定。"
                  },
                  "username": {
                    "type": "string",
                    "description": "登录名，唯一性由服务端保证（重复 → AlreadyExists）。"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "A successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.CreateUserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/users/{user_id}": {
      "get": {
        "tags": [
          "UserService"
        ],
        "summary": "读取单个用户。幂等。",
        "operationId": "UserService_GetUser",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "A successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.GetUserResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "UserService"
        ],
        "summary": "删除用户（软删除）。幂等。",
        "operationId": "UserService_DeleteUser",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "A successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.DeleteUserResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "UserService"
        ],
        "summary": "部分更新（PATCH 三态语义，见 UpdateUserRequest 注释）。幂等。",
        "operationId": "UserService_UpdateUser",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "description": "目标用户。",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "avatarUrl": {
                    "type": "string",
                    "description": "头像：三态。空串 = 显式清空；非空必须为 http(s) URL。\n长度上限由 max_len 承担（RE2 重复计数上限为 1000，{1,2048} 无法编译）。"
                  },
                  "nickname": {
                    "type": "string",
                    "description": "昵称：三态。空串 = 显式清空；非空 = 2~32 位任意字符。"
                  },
                  "phone": {
                    "type": "string",
                    "description": "手机号：三态。空串 = 显式清空；非空必须为中国大陆手机号。"
                  },
                  "status": {
                    "$ref": "#/components/schemas/user.v1.UserStatus",
                    "description": "状态：仅两态（Absent = 不变 / 显式传值 = 变更）。\n枚举无法表达\"清空\"，若需恢复默认请显式传 USER_STATUS_INACTIVE 等业务态（规范 §5.3 铁律 3）。"
                  },
                  "updateMask": {
                    "type": "string",
                    "description": "---- 方案 B（可选启用）：FieldMask 白名单更新（AIP-134，规范 §5.5）----\n若设置 update_mask，则语义切换为：仅更新 mask 声明的路径；\noptional 字段退化为两态（present = 更新 / absent = 不动），显式清空 = mask 路径 + 零值。\n服务端必须校验路径白名单，拒绝未声明路径。"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/google.rpc.Status"
                }
              }
            }
          },
          "200": {
            "description": "A successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/user.v1.UpdateUserResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "google.rpc.Status": {
        "type": "object",
        "description": "The Status type defines a logical error model suitable for different programming environments.",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "The status code, which should be an enum value of google.rpc.Code."
          },
          "details": {
            "type": "array",
            "description": "A list of messages that carry the error details.",
            "items": {
              "type": "object",
              "properties": {
                "@type": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "message": {
            "type": "string",
            "description": "A developer-facing error message."
          }
        }
      },
      "user.v1.ChangePasswordResponse": {
        "type": "object",
        "properties": {
          "passwordChangedAt": {
            "type": "string",
            "format": "date-time",
            "description": "密码更新时间（服务端时钟）。服务端应同时吊销该用户其他会话的刷新令牌。"
          }
        }
      },
      "user.v1.CreateUserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/user.v1.User",
            "description": "创建成功的资源快照。"
          }
        }
      },
      "user.v1.DeleteUserResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "被删除资源的 ID 回显，供调用方幂等对账。"
          }
        }
      },
      "user.v1.GetUserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/user.v1.User"
          }
        }
      },
      "user.v1.ListUsersResponse": {
        "type": "object",
        "properties": {
          "nextPageToken": {
            "type": "string",
            "description": "下一页游标；空串表示没有更多数据。"
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/user.v1.User"
            }
          }
        }
      },
      "user.v1.LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT / 不透明令牌。"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "access token 过期时间（服务端时钟）。"
          },
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌， rotation 策略由认证模块定义。"
          },
          "tokenType": {
            "type": "string",
            "description": "令牌类型（OAuth2 惯例），服务端固定返回 \"Bearer\"。"
          },
          "user": {
            "$ref": "#/components/schemas/user.v1.User",
            "description": "登录成功后的用户资源快照。"
          }
        }
      },
      "user.v1.ResetPasswordResponse": {
        "type": "object",
        "properties": {
          "temporaryPassword": {
            "type": "string",
            "description": "服务端生成的一次性临时密码，仅本次响应返回，不落明文日志；\n用户首次登录必须修改密码（服务端标记强制改密状态）。"
          }
        }
      },
      "user.v1.UpdateUserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/user.v1.User"
          }
        }
      },
      "user.v1.User": {
        "type": "object",
        "description": "用户资源。服务端返回体；服务端负责 user_id/username 唯一性与审计字段的填充。",
        "properties": {
          "avatarUrl": {
            "type": "string",
            "description": "头像 URL。optional：未设置 = 无头像。"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "审计字段，服务端填充。"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "description": "删除时间（软删除）。optional：未删除 = 未设置；非空即表示已删除，与 DeleteUser 呼应。"
          },
          "email": {
            "type": "string",
            "description": "邮箱。"
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "description": "最后登录时间。optional：从未登录 = 未设置（Zero Value Trap 语义，见规范 §5）。"
          },
          "lastLoginIp": {
            "type": "string",
            "description": "最后登录 IP（IPv4/IPv6）。optional：从未登录 = 未设置。"
          },
          "nickname": {
            "type": "string",
            "description": "展示昵称。optional：业务允许\"未设置\"状态，与空串严格区分（Zero Value Trap，见规范 §5）。"
          },
          "passwordHash": {
            "type": "string",
            "description": "密码哈希（bcrypt，60 字符）。服务端独占字段：仅用于登录校验与存储。\n严禁通过任何 API 响应下发 —— toProto 映射时必须显式置空（见 EXAMPLES.md §5）。"
          },
          "phone": {
            "type": "string",
            "description": "手机号：中国大陆格式。optional：可能未绑定。"
          },
          "roles": {
            "type": "array",
            "description": "全局角色，去重，至多 10 个。",
            "items": {
              "$ref": "#/components/schemas/user.v1.UserRole"
            }
          },
          "status": {
            "$ref": "#/components/schemas/user.v1.UserStatus",
            "description": "账号状态。optional：查询/过滤等场景\"未设置\"= 不过滤。"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "userId": {
            "type": "string",
            "description": "全局唯一 ID（UUID v4），服务端生成。"
          },
          "username": {
            "type": "string",
            "description": "登录名：字母开头，3~32 位字母/数字/下划线。唯一性由服务端保证。"
          }
        }
      },
      "user.v1.UserRole": {
        "type": "string",
        "description": "全局角色。",
        "enum": [
          "USER_ROLE_UNSPECIFIED",
          "USER_ROLE_ADMIN",
          "USER_ROLE_EDITOR",
          "USER_ROLE_VIEWER"
        ]
      },
      "user.v1.UserStatus": {
        "type": "string",
        "description": "用户账号状态。",
        "enum": [
          "USER_STATUS_UNSPECIFIED",
          "USER_STATUS_ACTIVE",
          "USER_STATUS_INACTIVE",
          "USER_STATUS_LOCKED"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "UserService"
    }
  ]
}